# Copy this file to .env and fill in the real values:
#     cp .env.example .env && chmod 600 .env
#
# .env holds the SQL password and the SMEAssist auth token. It is gitignored;
# keep it off shared drives too.

# --- Sage 300 SQL Server (read-only login; every query in this repo is a SELECT)
SQL_HOST=
SQL_PORT=1433
SQL_USER=
SQL_PASSWORD=
SQL_DATABASE=

# --- SMEAssist target org. No defaults in the code: a wrong-but-plausible
#     value here would post bills into the wrong organisation.
SME_BASE=http://<smeassist-host>:9069/api/v1
SME_ORG_ID=
SME_NAMESPACE=
SME_ORG_GSTIN=
SME_ORG_PAN=

# --- Auth. Short-lived; refresh before a long run. SME_TOKEN is preferred,
#     SME_COOKIE ('auth-token=...') is the fallback.
SME_TOKEN=
SME_COOKIE=

# --- Host running the smeassist MySQL, for the verify/probe scripts in work/
#     that shell out over ssh.
SME_DB_HOST=

# --- AR (sales) invoices, for post_sage_invoices.py -------------------------
# The cutover. A document Sage still shows open BEFORE this date is a
# receivable the new system carries, so it loads as an invoice; one settled
# before it belongs to the opening trial balance and must not be re-posted.
SME_CUTOVER=20260401

# The org's Letter of Undertaking, under which an export ships without payment
# of IGST. The ORG's own tax registration detail, so it lives here beside
# SME_ORG_GSTIN rather than being read out of a Sage table this repo has never
# inventoried.
#
# ONE LUT COVERS ONE FINANCIAL YEAR, and this population is not one year: the
# open exports span FY2021-22, FY2023-24, FY2024-25 and FY2025-26. The invoice
# carries the number as its own igstexemptionNumber, so stamping a 2026 LUT on
# a 2021 invoice asserts an exemption under a document that did not exist then.
# Give one entry per year. An export whose year has no entry is HELD.
#
#   SME_LUT=<fy>:<number>@<yyyymmdd>,<fy>:<number>@<yyyymmdd>
#   e.g. SME_LUT=2024-2025:AD2904xxxxxxxxx@20240401,2025-2026:AD2904yyyyyyyyy@20250401
SME_LUT=

# Legacy single-LUT form. Still honoured, and it registers for the ONE
# financial year SME_LUT_DATE falls in - which is what a single LUT covers.
SME_LUT_NUMBER=
SME_LUT_DATE=          # yyyymmdd

# The BUYER contact category. A different id from the vendor category the bills
# path uses, and org-specific like the company address id. Optional - the
# loader carries the devbox org's value as its default.
SME_BUYER_CATEGORY=

# --- Gemini, for foreign addresses and postal codes ------------------------
# Sage carries no address for most export customers, and the platform's address
# rows are NOT NULL. This is the one place the codebase knowingly relaxes
# "nothing is guessed", and it is fenced: it runs only for an international
# customer Sage gives no address for, it discards its own LOW-confidence
# answers, it is instructed never to invent a street, and every contact built
# from one is stamped addressSource=gemini-enriched:<confidence> in metaData so
# it can be re-sourced from a real document later. Leave it unset, or pass
# --no-enrich, to take the flagged placeholder instead.
#
# BOTH loaders use it, and it is also asked for a foreign POSTAL CODE when the
# one Sage holds is not in the platform's geo table. A code it returns is put
# through that table like any other candidate before anything is filed under
# it, so the enrichment cannot introduce a postal code the platform does not
# independently know.
#
# Use the BACKEND's already-configured key (ai.properties -> gemini.api.key).
# Do not mint a new one.
GEMINI_API_KEY=
# The free tier's cap is 20 calls per DAY, PER MODEL, so this is also the
# lever for headroom - flash-lite is its own bucket and answers these two
# questions (a registered address, a city's postal codes) perfectly well.
GEMINI_MODEL=gemini-2.5-flash-lite
