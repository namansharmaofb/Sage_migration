# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
work/venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Business data — real vendor names, GSTINs, addresses, invoice numbers and
# amounts. Reproducible from extract.sql; never committed.
# ---------------------------------------------------------------------------
output/
ref/
state/
*.csv
*.psv
crosswalk.json
crosswalk_live.json
masters_crosswalk.json
work/*.json
work/repost_needed_po_items.txt

# ---------------------------------------------------------------------------
# Run artefacts
# ---------------------------------------------------------------------------
logs/
work/logs/
*.log
# Pointer files that name the current run log (e.g. work/.gm_current_log).
# The name ends in "_log", not ".log", so the pattern above misses it.
*_log

# ---------------------------------------------------------------------------
# Internal infrastructure records — host names, firewall rules, SQL logins,
# devbox internals. Kept out of a public repo.
# ---------------------------------------------------------------------------
MACHINE-CHANGES.md
DEVBOX-REFERENCE-SNAPSHOT.txt
PROMPT-*.md
windows-claude-prompt-*.txt

# ---------------------------------------------------------------------------
# Editor / tooling / local backups
# ---------------------------------------------------------------------------
# .claude/ holds local settings and state, but the agent definitions in
# .claude/agents/ are team knowledge and belong in the repo. Git cannot
# re-include through an excluded PARENT, so this excludes the contents
# rather than the directory itself, then un-excludes agents/.
.claude/*
!.claude/agents/
.idea/
.vscode/
*.swp
*.bak
*.before-*
# Same thing under the shorter name used from 4 Sep (.b4-<tag>-<stamp>).
*.b4-*
*~
.DS_Store
